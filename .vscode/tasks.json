{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Game",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/gcc.exe",
            "options": {
                "env": {
                    "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            },
            "args": [
                "src/*.c",               // all source files
                "-Iinclude",             // include your header folder
                "-o", "build-win/peli.exe" // Windows output executable
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}