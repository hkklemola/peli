    <table:table-column table:style-name="co10" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co11" table:number-columns-repeated="3" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co12" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co11" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co13" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co11" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co14" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co11" table:number-columns-repeated="3" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co15" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co8" table:number-columns-repeated="167" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co16" table:number-columns-repeated="443" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co8" table:number-columns-repeated="331" table:default-cell-style-name="Default"/>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p># LibreOffice Calc world map master sheet (.ods recommended; .csv runtime export)</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="999"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p># Each tile cell can contain: BIOME|loc=Name|type=TOWN|index=6|gen=PROCEDURAL|w=1000|h=1000|road=trail</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="999"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p># Biome codes row 1</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>GR</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>FO</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>FA</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>DE</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>TU</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="994"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p># Biome names row 1</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Grasslands</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Forest</text:p>
