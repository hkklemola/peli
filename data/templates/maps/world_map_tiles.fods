<office:body><office:spreadsheet>
<table:table table:name="World Map">
<table:table-column table:style-name="co_map" table:number-columns-repeated="1000"/>
<table:table-row table:style-name="ro_legend">
<table:table-cell table:style-name="ce_comment" office:value-type="string"><text:p># LibreOffice Calc world map master sheet (.ods recommended; .csv runtime export)</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" table:number-columns-repeated="999"/>
</table:table-row>
<table:table-row table:style-name="ro_legend">
<table:table-cell table:style-name="ce_comment" office:value-type="string"><text:p># Each tile cell can contain: BIOME|loc=Name|type=TOWN|index=6|gen=PROCEDURAL|w=1000|h=1000|road=trail|river=major|lake=large</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" table:number-columns-repeated="999"/>
</table:table-row>
<table:table-row table:style-name="ro_legend">
<table:table-cell table:style-name="ce_comment" office:value-type="string"><text:p># Biome codes row 1</text:p></table:table-cell>
<table:table-cell table:style-name="ce_gr" office:value-type="string"><text:p>GR</text:p></table:table-cell>
<table:table-cell table:style-name="ce_fo" office:value-type="string"><text:p>FO</text:p></table:table-cell>
<table:table-cell table:style-name="ce_fa" office:value-type="string"><text:p>FA</text:p></table:table-cell>
<table:table-cell table:style-name="ce_de" office:value-type="string"><text:p>DE</text:p></table:table-cell>
<table:table-cell table:style-name="ce_tu" office:value-type="string"><text:p>TU</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" table:number-columns-repeated="994"/>
</table:table-row>
<table:table-row table:style-name="ro_legend">
<table:table-cell table:style-name="ce_comment" office:value-type="string"><text:p># Biome names row 1</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" office:value-type="string"><text:p>Grasslands</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" office:value-type="string"><text:p>Forest</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" office:value-type="string"><text:p>Farmlands</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" office:value-type="string"><text:p>Desert</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" office:value-type="string"><text:p>Tundra</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" table:number-columns-repeated="994"/>
</table:table-row>
