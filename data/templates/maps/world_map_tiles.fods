</table:table-row>
<table:table-row table:style-name="ro_legend">
<table:table-cell table:style-name="ce_comment" office:value-type="string"><text:p># Feature tiers</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" office:value-type="string"><text:p>road=trail|paved|highway</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" office:value-type="string"><text:p>river=minor|major</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" office:value-type="string"><text:p>lake=small|large</text:p></table:table-cell>
<table:table-cell table:style-name="ce_blank" table:number-columns-repeated="996"/>
</table:table-row>
